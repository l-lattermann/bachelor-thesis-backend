{
  "type": "object",
  "properties": {
    "inferred_task": {
      "type": "string",
      "description": "What the LLM understood from the user command (e.g., 'Handover to human', 'Bin picking', 'Tool use')."
    },
    "selected_grasp_id": {
      "type": ["integer", "null"],
      "description": "The ID of the best executable grasp that fits the task. Return null if no grasp is valid."
    },
    "final_decision_reason": {
      "type": "string",
      "description": "Final summary explaining the choice, balancing physical contact quality with task suitability (e.g., 'Grasp 3 makes solid contact on the metal shaft, leaving the handle free for the user.')."
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grasp_id": { "type": "integer" },
          "physics_and_task_critique": { 
            "type": "string", 
            "description": "Detailed observation of physical gaps, plus how the grasp placement impacts the intended task." 
          },
          "scores": {
            "type": "object",
            "properties": {
              "contact_validity": { "type": "integer", "minimum": 0, "maximum": 2 },
              "lift_stability": { "type": "integer", "minimum": 0, "maximum": 2 },
              "approach_collision": { "type": "integer", "minimum": 0, "maximum": 2 },
              "retreat_collision": { "type": "integer", "minimum": 0, "maximum": 2 },
              "task_suitability": { "type": "integer", "minimum": 0, "maximum": 2 },
              "total_score": { "type": "integer", "minimum": 0, "maximum": 10 }
            },
            "required": [
              "contact_validity", "lift_stability", "approach_collision", 
              "retreat_collision", "task_suitability", "total_score"
            ],
            "additionalProperties": false
          }
        },
        "required": ["grasp_id", "physics_and_task_critique", "scores"],
        "additionalProperties": false
      }
    }
  },
  "required": ["inferred_task", "selected_grasp_id", "final_decision_reason", "evaluations"],
  "additionalProperties": false
}